rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidCustomSprite(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.targetName is string && data.targetName.size() > 0 && data.targetName.size() <= 128
        && data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 350000;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Community Custom Sprites (Visible to everyone)
    match /custom_sprites/{spriteId} {
      allow read: if true;
      allow create, update: if isValidCustomSprite(request.resource.data);
      allow delete: if isSignedIn();
    }

    // User Profile
    match /users/{userId}/user_profile/{profileId} {
      allow read, write: if isOwner(userId);
    }

    // User's Finished Items Vault
    match /users/{userId}/finished_items/{itemId} {
      allow read, write: if isOwner(userId);
    }

    // User's Custom / Discovered Ingredients
    match /users/{userId}/custom_ingredients/{ingredientId} {
      allow read, write: if isOwner(userId);
    }

    // User's Custom / Discovered Crafting Methods
    match /users/{userId}/custom_methods/{methodId} {
      allow read, write: if isOwner(userId);
    }
  }
}
